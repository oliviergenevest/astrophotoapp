---
import Layout from '@/layouts/Layout.astro'
import { ImageOff } from 'lucide-react'
---

<Layout title="Page introuvable – Signa">
  <div class="min-h-screen flex flex-col items-center justify-center p-6 bg-signa-night">
    <div class="text-center max-w-sm">

      <div class="w-[88px] h-[88px] rounded-2xl flex items-center justify-center mx-auto mb-7 bg-signa-gold/10 border-[0.5px] border-signa-gold/20">
        <ImageOff className="w-9 h-9 text-signa-gold" />
      </div>

      <h1 class="font-syne text-[56px] font-bold text-signa-cream mb-2 tracking-tight">404</h1>
      <h2 class="font-syne text-lg font-semibold text-signa-cream/80 mb-3">Page introuvable</h2>
      <p class="text-signa-cream/40 text-sm mb-8 leading-relaxed">
        La page que vous cherchez n'existe pas ou a été déplacée.
      </p>

      <div class="space-y-2.5">
        <a href="/dashboard" class="block">
          <button class="w-full h-11 bg-signa-lime hover:brightness-95 text-signa-night rounded-lg text-sm font-syne font-semibold transition-all">
            Retour au dashboard
          </button>
        </a>
        <a href="/login" class="block">
          <button class="w-full h-11 bg-white border border-slate-300 hover:bg-slate-50 text-slate-600 rounded-lg text-sm font-medium transition-colors">
            Se connecter
          </button>
        </a>
      </div>

    </div>
  </div>
</Layout>