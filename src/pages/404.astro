---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="Page introuvable – PhotoApp">
  <div class="min-h-screen flex flex-col items-center justify-center p-6 bg-slate-50">
    <div class="text-center max-w-sm">

      <div class="w-24 h-24 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <span class="text-5xl">🔍</span>
      </div>

      <h1 class="text-6xl font-bold text-slate-800 mb-2">404</h1>
      <h2 class="text-xl font-semibold text-slate-600 mb-3">Page introuvable</h2>
      <p class="text-slate-400 text-sm mb-8">
        La page que vous cherchez n'existe pas ou a été déplacée.
      </p>

      <div class="space-y-3">
        <a href="/dashboard" class="block">
          <button class="w-full h-11 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">
            Retour au dashboard
          </button>
        </a>
        <a href="/login" class="block">
          <button class="w-full h-11 border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-lg text-sm font-medium transition-colors">
            Se connecter
          </button>
        </a>
      </div>

    </div>
  </div>
</Layout>