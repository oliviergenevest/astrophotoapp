---
import Layout from '@/layouts/Layout.astro'
import DashboardShell from '@/components/DashboardShell'
import SignaturesList from '@/components/SignaturesList'
import { createSupabaseServerClient } from '@/lib/supabase'
import { PenLine, FileText } from 'lucide-react'

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request)
const { data: { user } } = await supabase.auth.getUser()

const { data: activeContract } = await supabase
  .from('contracts')
  .select('id, name')
  .eq('photographer_id', user!.id)
  .eq('is_active', true)
  .single()
---

<Layout title="Dashboard – Signa">
  <DashboardShell
    user={user}
    activeContract={activeContract}
    currentPath="/dashboard"
    client:load
  >
    <div class="space-y-6">

      <!-- Cards d'action — visibles sur desktop, cachées sur mobile (bottom nav) -->
      <div class="hidden sm:grid grid-cols-2 gap-4">

        <!-- Nouvelle signature -->
        <a href="/nouvelle-signature" class="cursor-pointer">
          <div class="rounded-xl p-5 bg-signa-lime hover:opacity-90 transition-opacity">
            <PenLine className="h-6 w-6 mb-3 text-signa-night" />
            <p class="font-syne text-base font-semibold text-signa-night">
              Nouvelle signature
            </p>
            <p class="text-xs text-signa-night/60 mt-1">
              Faire signer un droit à l'image
            </p>
          </div>
        </a>

        <!-- Mes contrats -->
        <a href="/contrats" class="cursor-pointer">
          <div class="rounded-xl p-5 bg-signa-night-2 border-[0.5px] border-signa-gold/20 hover:opacity-90 transition-opacity">
            <FileText className="h-6 w-6 mb-3 text-signa-gold" />
            <p class="font-syne text-base font-semibold text-signa-cream">
              Mes contrats
            </p>
            <p class="text-xs text-signa-gold mt-1">
              {activeContract ? activeContract.name : 'Aucun contrat actif'}
            </p>
          </div>
        </a>

      </div>

      <!-- Liste des signatures -->
      <div class="rounded-xl overflow-hidden bg-signa-night-2 border-[0.5px] border-signa-gold/15">
        <div class="px-6 py-4 border-b-[0.5px] border-white/5">
          <h2 class="font-syne text-[0.9375rem] font-semibold text-signa-cream">
            Dernières signatures
          </h2>
        </div>
        <SignaturesList client:load />
      </div>

    </div>
  </DashboardShell>
</Layout>