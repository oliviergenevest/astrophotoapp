---
import { createSupabaseServerClient } from '@/lib/supabase'
import '@/styles/global.css'

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request)
const { data: { user } } = await supabase.auth.getUser()
if (!user) return Astro.redirect('/login')

const name = Astro.url.searchParams.get('name') ?? 'le signataire'
const email = Astro.url.searchParams.get('email') ?? ''
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lien envoyé – Signa</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex items-center justify-center p-6 bg-signa-night">

    <div class="w-full max-w-sm text-center">

      <!-- Icône -->
      <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 bg-signa-lime/10">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#AAFF00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 9.27a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </div>

      <!-- Titre -->
      <h1 class="font-syne text-2xl font-bold text-signa-cream mb-3">
        Lien envoyé !
      </h1>

      <!-- Message -->
      <p class="text-[0.9375rem] text-signa-cream/60 mb-1 leading-relaxed">
        Un email a été envoyé à <strong class="text-signa-gold">{name}</strong>
      </p>
      {email && (
        <p class="text-[0.8125rem] text-signa-cream/35 mb-8">{email}</p>
      )}

      <!-- Info OTP -->
      <div class="rounded-xl p-4 mb-8 text-left bg-signa-gold/[0.06] border-[0.5px] border-signa-gold/20">
        <p class="text-[0.8125rem] font-medium text-signa-gold mb-1">Ce que contient l'email</p>
        <p class="text-[0.8125rem] text-signa-cream/50 leading-relaxed">
          Un lien vers le document à signer + un code de vérification à 6 chiffres valable
          <strong class="text-signa-cream/70"> 15 minutes</strong>.
        </p>
      </div>

      <!-- Actions -->
      <div class="flex flex-col gap-3">
        <a href="/nouvelle-signature" class="block">
          <button class="w-full h-12 rounded-xl font-syne font-bold text-[0.9375rem] bg-signa-lime text-signa-night hover:brightness-95 transition-all">
            Nouvelle signature
          </button>
        </a>
        <a href="/dashboard" class="block">
          <button class="w-full h-11 rounded-xl text-sm text-signa-cream/40 border-[0.5px] border-signa-cream/10 hover:bg-signa-cream/5 transition-colors">
            Retour au dashboard
          </button>
        </a>
      </div>

    </div>

  </body>
</html>