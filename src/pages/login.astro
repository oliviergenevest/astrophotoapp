---
import '@/styles/global.css'
import LoginForm from '@/components/LoginForm'
import { createSupabaseServerClient } from '@/lib/supabase'

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request)
const { data: { user } } = await supabase.auth.getUser()
if (user) return Astro.redirect('/dashboard')
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion – Signa</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body style="background:#0F1923; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:1.5rem;">

    <div style="width:100%; max-width:420px;">

      <!-- Logo -->
      <div style="text-align:center; margin-bottom:2rem;">
        <h1 style="font-family:'Syne',sans-serif; font-size:2rem; font-weight:700; color:#C9A84C; letter-spacing:0.05em;">
          Signa
        </h1>
        <p style="font-size:0.875rem; color:rgba(245,240,232,0.4); margin-top:0.25rem;">
          Signature électronique du droit à l'image
        </p>
      </div>

      <!-- Card -->
      <div style="background:#1A2733; border-radius:1rem; padding:2rem; border:0.5px solid rgba(201,168,76,0.2);">
        <LoginForm client:load />
      </div>

    </div>

  </body>
</html>