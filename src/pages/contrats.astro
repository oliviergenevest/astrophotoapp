---
import Layout from '@/layouts/Layout.astro'
import DashboardShell from '@/components/DashboardShell'
import ContratsList from '@/components/ContratsList'
import { createSupabaseServerClient } from '@/lib/supabase'

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request)
const { data: { user } } = await supabase.auth.getUser()

// Récupère les contrats
const { data: contracts } = await supabase
  .from('contracts')
  .select('id, name, file_path, is_active, created_at')
  .eq('photographer_id', user!.id)
  .order('created_at', { ascending: false })

// Génère une URL signée (1h) pour chaque contrat côté serveur
const contractsWithUrls = await Promise.all(
  (contracts ?? []).map(async (contract) => {
    const { data } = await supabase.storage
      .from('contracts')
      .createSignedUrl(contract.file_path, 3600)
    return { ...contract, signed_url: data?.signedUrl ?? null }
  })
)

const activeContract = contractsWithUrls.find(c => c.is_active) ?? null
---

<Layout title="Mes contrats – Signa">
  <DashboardShell currentPath="/contrats" user={user} activeContract={activeContract} client:load>
    <div class="rounded-xl overflow-hidden bg-signa-night-2 border-[0.5px] border-signa-gold/15">
      <div class="px-6 py-4 border-b-[0.5px] border-white/5">
        <h2 class="font-syne text-[0.9375rem] font-semibold text-signa-cream">
          Mes contrats
        </h2>
      </div>
      <ContratsList contracts={contractsWithUrls} userId={user!.id} client:load />
    </div>
  </DashboardShell>
</Layout>