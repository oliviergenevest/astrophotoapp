---
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Signature électronique du droit à l\'image pour photographes'
} = Astro.props
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />

    <!-- PWA de base -->
    <meta name="theme-color" content="#1e3a5f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PhotoApp" />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Manifest PWA -->
    <link rel="manifest" href="/manifest.json" />

    <title>{title}</title>
  </head>
  <body class="antialiased text-slate-800 bg-slate-50">
    <slot />
  </body>
</html>